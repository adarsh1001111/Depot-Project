<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Orders" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <header class="bg-slate-900 text-white py-4 px-6">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div>
          <h1 class="text-2xl font-semibold">My Orders</h1>
          <p class="text-sm text-slate-300">Depot Project order history and line items</p>
        </div>
        <nav class="space-x-4">
          <%= link_to 'Orders', orders_users_path, class: 'text-slate-200 hover:text-white' %>
          <%= link_to 'Line Items', line_items_users_path, class: 'text-slate-200 hover:text-white' %>
          <%= link_to 'Home', store_index_path, class: 'text-slate-200 hover:text-white' %>
        </nav>
      </div>
    </header>
    <main class="max-w-7xl mx-auto p-6">
      <%= yield %>
    </main>
  </body>
</html>
