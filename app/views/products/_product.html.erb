<div id="<%= dom_id product %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= product.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= product.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Image:</strong>
    <% if product.image.attached? %>
      <%= image_tag(product.image, class: 'w-32 h-32 object-contain', width: 128, height: 128, style: 'max-width: 128px; max-height: 128px;') %>
      <br>
      <%= link_to product.image.filename, product.image, class: "text-gray-700 underline hover:no-underline" %>
    <% end %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= product.price %>
  </div>
</div>
