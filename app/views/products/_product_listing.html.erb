<article id="product_<%= product.id %>" class="bg-white rounded-xl shadow p-6 mb-6">
  <div class="flex items-start gap-6">
    <div class="w-32 h-32 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden">
      <% if product.all_images.present? %>
        <%= image_tag(product.all_images.first, class: "object-contain w-full h-full") %>
      <% end %>
    </div>

    <div class="flex-1">
      <h2 class="font-bold text-xl"><%= product.title %></h2>
      <p class="text-sm text-gray-600 mt-2"><%= truncate(strip_tags(product.description), length: 100) %></p>
      <p class="text-sm text-gray-500 mt-2">Category: <%= product.category&.name || 'Unassigned' %></p>
      <p class="font-semibold mt-3"><%= number_to_currency(product.price) %></p>

      <div class="mt-4 space-x-3 text-sm">
        <%= link_to 'Show', product, class: 'text-blue-600 hover:underline' %>
        <%= link_to 'Edit', edit_product_path(product), class: 'text-blue-600 hover:underline' %>
        <%= button_to 'Destroy', product, method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'text-red-600 hover:underline inline' %>
      </div>
    </div>
  </div>
</article>
