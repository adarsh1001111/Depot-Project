<%= turbo_frame_tag(dom_id(product)) do %>
  <li class='flex mb-6'>
    <% if product.image.attached? %>
      <%= image_tag(product.image,
        class: 'object-contain shadow mr-6',
        width: 160,
        height: 192,
        style: 'max-width: 160px; max-height: 192px;') %>
    <% end %>
    <div>
      <h2 class="font-bold text-lg mb-3"><%= product.title %></h2>
      <p>
        <%= sanitize(product.description) %>
      </p>
      <div class="mt-3">
        <%= number_to_currency(product.price) %>
        <%= button_to t(".add_html"),
            line_items_path(product_id: product),
            form_class: "inline",
            class: 'ml-4 rounded-lg py-1 px-2
                    text-white bg-green-600' %>
      </div>
    </div>
  </li>
<% end %>