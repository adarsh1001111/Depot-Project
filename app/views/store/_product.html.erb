<%= turbo_frame_tag(dom_id(product)) do %>
  <% current_rating = authenticated? ? product.ratings.find { |rating| rating.user_id == Current.user&.id } : nil %>
  <li class='flex mb-6'>
    <% if product.all_images.present? %>
      <%= image_tag(product.all_images.first,
        class: 'object-contain shadow mr-6',
        width: 160,
        height: 192,
        style: 'max-width: 160px; max-height: 192px;') %>
    <% end %>
    <div>
      <h2 class="font-bold text-lg mb-1"><%= product.title %></h2>
      <p class="text-sm text-gray-700 mb-2">
        <span data-rating-average-value><%= format("%.1f", product.average_rating) %></span>/5
      </p>
      <p>
        <%= sanitize(product.description) %>
      </p>
      <div class="mt-3">
        <%= number_to_currency(product.price) %>
        <%= button_to t(".add_html"),
            line_items_path(product_id: product),
            form_class: "inline",
            class: 'ml-4 rounded-lg py-1 px-2
                    text-white bg-green-600' %>
      </div>
      <% if authenticated? %>
        <div
          class="mt-3"
          data-controller="rating"
          data-rating-url-value="<%= product_rating_path(product, locale: I18n.locale) %>"
          data-rating-success-message-value="<%= t('ratings.messages.saved') %>"
          data-rating-failure-message-value="<%= t('ratings.messages.failed') %>"
        >
          <label class="mr-2"><%= t("ratings.label") %></label>
          <select data-rating-target="select" class="border rounded p-1">
            <% (0..10).map { |i| i * 0.5 }.each do |value| %>
              <option value="<%= value %>" <%= "selected" if current_rating&.value.to_f == value %>>
                <%= format("%.1f", value) %>
              </option>
            <% end %>
          </select>
          <button
            type="button"
            data-action="click->rating#submit"
            class="ml-2 rounded-lg py-1 px-2 text-white bg-blue-600"
          >
            <%= t("ratings.submit") %>
          </button>
          <p data-rating-target="message" class="text-sm mt-2"></p>
        </div>
      <% end %>
    </div>
  </li>
<% end %>