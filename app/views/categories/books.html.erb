<% content_for :title, "Books in #{ @category.name }" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold mb-6">Books in <%= @category.name %></h1>

  <% if @books.any? %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @books.each do |book| %>
        <div class="border rounded-lg p-4 shadow-sm">
          <h2 class="text-xl font-semibold mb-2"><%= link_to book.title, product_path(book), class: "text-blue-600 hover:underline" %></h2>
          <p class="text-sm text-gray-500">Category: <%= book.category&.name || "Uncategorized" %></p>
          <p class="mt-3 text-gray-700"><%= truncate(book.description, length: 120) %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">No books found for this category.</p>
  <% end %>
</div>
